# Optimisations pnpm pour réduire la taille et accélérer les installations.
# ATTENTION : depuis pnpm 11, ces clés ne sont plus lues ici — les réglages
# équivalents (nodeLinker, shamefullyHoist, autoInstallPeers…) sont dans
# pnpm-workspace.yaml, qui fait foi. Ce fichier ne sert plus qu'aux postes
# restés en pnpm 10 ; garder les deux en cohérence.
shamefully-hoist=true
auto-install-peers=true
strict-peer-dependencies=false
node-linker=hoisted
