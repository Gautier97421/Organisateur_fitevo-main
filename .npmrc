# Optimisations pnpm pour réduire la taille et accélérer les installations
shamefully-hoist=true
auto-install-peers=true
strict-peer-dependencies=false
node-linker=hoisted
# pnpm 11+ revérifie/complète node_modules à chaque "pnpm <script>" (runDepsStatusCheck),
# y compris au runtime dans le conteneur — sans ceci, ce contrôle échoue car les scripts
# d'installation (prisma, sharp, esbuild...) ne sont pas approuvés en dehors du build.
dangerously-allow-all-builds=true
